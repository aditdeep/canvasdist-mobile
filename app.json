{
  "expo": {
    "name": "CanvasDist",
    "slug": "canvasdist-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "canvasdist",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.canvasdist.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CanvasDist butuh lokasi kamu untuk checkin kunjungan dan tracking pengiriman.",
        "NSCameraUsageDescription": "CanvasDist butuh akses kamera untuk foto checkin, bukti terima (POD), dan barang bekas."
      }
    },
    "android": {
      "package": "com.canvasdist.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#5b5ff0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA", "POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5b5ff0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CanvasDist butuh lokasi kamu untuk checkin kunjungan dan tracking pengiriman."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "CanvasDist butuh akses kamera untuk foto checkin, bukti terima (POD), dan barang bekas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5b5ff0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
        "extra": {
      "apiUrl": "https://api.canvasdist.my.id/api",
      "eas": {
        "projectId": "8fda9e72-1e10-48d8-b5b6-0efd850eb634"
      }
    }
  }
}
